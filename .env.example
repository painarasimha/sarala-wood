# Resend — transactional email for the commission enquiry form
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered (comma-separated for multiple recipients)
ENQUIRY_TO_EMAIL=sarala.mill@yahoo.com,suhaskumarhegde@gmail.com

# Verified sending domain in Resend, e.g. "Sarala Wood Industries <enquiries@saralawood.com>"
ENQUIRY_FROM_EMAIL=Sarala Wood Industries <onboarding@resend.dev>

# Canonical site URL (used for metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://saralawood.com
